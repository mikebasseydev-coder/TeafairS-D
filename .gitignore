.claude/*
!.claude/awards-mobile-workflow.md
# visual references stay local
.claude/references/

# Environment — never commit Supabase URLs or keys
.env
.env*.local
supabase/.env.prod.secrets

# Package installs (the app gets its own setup under Spec B)
node_modules/

# Deno writes a lockfile wherever it runs; the functions pin their own versions
deno.lock

# design reference pipeline: harvested screenshots and tokens stay local
.design-refs/

# transient Playwright output (MCP browser sessions, test runs)
.playwright-mcp/
test-results/
playwright-report/

# the Expo app (Spec B): build output and generated local files
dist-web/
.expo/
expo-env.d.ts
web-build/
