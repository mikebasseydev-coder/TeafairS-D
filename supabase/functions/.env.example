# Copy to supabase/functions/.env (gitignored). Loaded by `supabase functions serve`.
AUTH_HOOK_SECRET=v1,whsec_REPLACE_WITH_BASE64_SECRET
PAYSTACK_SECRET_KEY=sk_test_REPLACE
# Omit in real environments (defaults to https://api.paystack.co).
# Local integration tests point it at their fake Paystack:
PAYSTACK_API_BASE=http://host.docker.internal:54399
# kudisms in real environments; log prints codes to the function log and
# refuses to start anywhere but the local stack (auth audit L1)
SMS_PROVIDER=log
KUDISMS_TOKEN=
KUDISMS_SENDER_ID=
# Optional KudiSMS route, sent as the `gateway` form field only when set.
# Confirm the value for the corporate (DND) route with KudiSMS before setting it.
KUDISMS_GATEWAY=
# Public gateways (addendum A1). Comma-separated browser origins allowed by CORS.
WEB_ALLOWED_ORIGINS=http://localhost:3000
# Where Paystack returns the buyer after paying.
WEB_CHECKOUT_CALLBACK_URL=http://localhost:3000/checkout/complete
# Cloudflare Turnstile. Locally the integration test's fake answers at TURNSTILE_VERIFY_URL;
# omit TURNSTILE_VERIFY_URL in real environments.
TURNSTILE_SECRET_KEY=local-test-secret
TURNSTILE_VERIFY_URL=http://host.docker.internal:54399/turnstile/v0/siteverify
# Cron-invoked functions (reconcile-funds, web-commission-release) check the
# x-cron-secret header against this. It must equal the Vault secret `cron_secret`
# in the same environment (see supabase/CLAUDE.md, "Cron jobs").
CRON_SECRET=local-cron-secret
# support-ticket-open (addendum A3): HMAC key for the buyer's ticket secret, 32+
# random bytes as base64url (e.g. openssl rand -base64 32 | tr '+/' '-_' | tr -d '=').
# Rotating it only breaks replays of opens still in flight; tickets keep their hashes.
SUPPORT_TICKET_SECRET_KEY=
# WhatsApp Cloud API (addendum A5 §7). With the first three empty the router sends SMS only.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=
# Optional: point at a fake WhatsApp API (integration tests); omit in real environments.
WHATSAPP_API_URL=
# Approved Meta template names (defaults shown).
WHATSAPP_TEMPLATE_OTP=teafair_otp
WHATSAPP_TEMPLATE_DELIVERY_CODE=teafair_delivery_code
# Order dispatch / delivery-code gateways (addendum A5, R16) and otp-issue (auth audit H2): the proof the RPCs demand.
# The same value goes in Vault as `gateway_secret`. Never log or return it.
GATEWAY_SECRET=
# Sentry (backend observability). Empty DSN = Sentry off (nothing is sent).
# Real environments: the DSN of the Teafair backend project in Sentry.
# Local integration tests: http://public@host.docker.internal:54399/1 (the test's fake ingest).
SENTRY_DSN=
# local | staging | production
SENTRY_ENVIRONMENT=local
# Optional: the git SHA being deployed.
SENTRY_RELEASE=
# Share of requests traced, 0 to 1 (default 1). Lower it when traffic grows.
SENTRY_TRACES_SAMPLE_RATE=1
# Supabase Auth Send SMS / Send Email hooks (auth audit M1). Each must equal the
# secret of the same name in supabase/.env (local) or the dashboard hook (remote).
SEND_SMS_HOOK_SECRET=v1,whsec_REPLACE_WITH_BASE64_SECRET
SEND_EMAIL_HOOK_SECRET=v1,whsec_REPLACE_WITH_BASE64_SECRET
# send-auth-sms: sign-in codes go on WhatsApp only; "true" adds the KudiSMS fallback.
AUTH_OTP_SMS_FALLBACK=false
# send-auth-email: Resend. RESEND_API_URL is for tests only (the integration fake).
RESEND_API_KEY=
RESEND_API_URL=
AUTH_EMAIL_FROM=Teafair <auth@REPLACE_WITH_VERIFIED_DOMAIN>
# The app's base URL; recovery links return to <AUTH_SITE_URL>/reset-password.
AUTH_SITE_URL=http://127.0.0.1:3000
# Extra exact redirect URLs, comma-separated (must also be in Auth's allowlist).
AUTH_EMAIL_REDIRECT_URLS=
# Public Auth base URL for links (locally http://127.0.0.1:54321; remote: leave empty to use SUPABASE_URL).
AUTH_EMAIL_LINK_BASE=http://127.0.0.1:54321
